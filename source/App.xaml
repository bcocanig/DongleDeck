<Window xmlns='http://schemas.microsoft.com/winfx/2006/xaml/presentation' xmlns:x='http://schemas.microsoft.com/winfx/2006/xaml' Title='DongleDeck' Width='1000' Height='850' MinWidth='860' MinHeight='740' WindowStartupLocation='CenterScreen' Background='{DynamicResource Canvas}' FontFamily='Segoe UI' Foreground='{DynamicResource Text}'>
 <Window.Resources>
  <Style TargetType='Button'>
   <Setter Property='Background' Value='{DynamicResource Card}'/><Setter Property='Foreground' Value='{DynamicResource Text}'/><Setter Property='BorderBrush' Value='{DynamicResource Border}'/><Setter Property='BorderThickness' Value='1'/><Setter Property='Padding' Value='16,10'/><Setter Property='FontSize' Value='13'/><Setter Property='FontWeight' Value='SemiBold'/><Setter Property='Cursor' Value='Hand'/>
   <Setter Property='Template'><Setter.Value><ControlTemplate TargetType='Button'><Border x:Name='Border' CornerRadius='7' Background='{TemplateBinding Background}' BorderBrush='{TemplateBinding BorderBrush}' BorderThickness='{TemplateBinding BorderThickness}' Padding='{TemplateBinding Padding}'><ContentPresenter HorizontalAlignment='Center' VerticalAlignment='Center'/></Border><ControlTemplate.Triggers><Trigger Property='IsMouseOver' Value='True'><Setter TargetName='Border' Property='Opacity' Value='0.82'/></Trigger><Trigger Property='IsEnabled' Value='False'><Setter TargetName='Border' Property='Opacity' Value='0.40'/></Trigger><Trigger Property='IsKeyboardFocused' Value='True'><Setter TargetName='Border' Property='BorderBrush' Value='{DynamicResource Accent}'/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key='Primary' TargetType='Button' BasedOn='{StaticResource {x:Type Button}}'><Setter Property='Background' Value='#245FC3'/><Setter Property='BorderBrush' Value='#245FC3'/><Setter Property='Foreground' Value='White'/></Style>
  <Style TargetType='ToolTip'><Setter Property='Background' Value='{DynamicResource Card}'/><Setter Property='Foreground' Value='{DynamicResource Text}'/><Setter Property='BorderBrush' Value='{DynamicResource Border}'/></Style>
  <Style TargetType='ComboBoxItem'><Setter Property='Foreground' Value='{DynamicResource Text}'/><Setter Property='Padding' Value='10,9'/><Setter Property='Template'><Setter.Value><ControlTemplate TargetType='ComboBoxItem'><Border x:Name='ItemBorder' Background='{DynamicResource Card}' Padding='{TemplateBinding Padding}'><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property='IsHighlighted' Value='True'><Setter TargetName='ItemBorder' Property='Background' Value='{DynamicResource AccentSoft}'/></Trigger><Trigger Property='IsSelected' Value='True'><Setter TargetName='ItemBorder' Property='Background' Value='{DynamicResource Subtle}'/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType='ComboBox'>
   <Setter Property='FontSize' Value='14'/><Setter Property='Foreground' Value='{DynamicResource Text}'/><Setter Property='MinHeight' Value='40'/><Setter Property='ScrollViewer.CanContentScroll' Value='True'/>
   <Setter Property='Template'><Setter.Value><ControlTemplate TargetType='ComboBox'><Grid><ToggleButton Focusable='False' IsChecked='{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}' Background='{DynamicResource Card}' Foreground='{DynamicResource Text}'>
    <ToggleButton.Template><ControlTemplate TargetType='ToggleButton'><Border Background='{TemplateBinding Background}' BorderBrush='{DynamicResource Border}' BorderThickness='1' CornerRadius='7'><TextBlock Text='⌄' FontSize='18' HorizontalAlignment='Right' Margin='0,0,12,0' VerticalAlignment='Center'/></Border></ControlTemplate></ToggleButton.Template>
   </ToggleButton><ContentPresenter Margin='12,8,34,8' Content='{TemplateBinding SelectionBoxItem}' ContentTemplate='{TemplateBinding SelectionBoxItemTemplate}' VerticalAlignment='Center' IsHitTestVisible='False'/><Popup x:Name='PART_Popup' Placement='Bottom' IsOpen='{TemplateBinding IsDropDownOpen}' AllowsTransparency='True' Focusable='False' PopupAnimation='Fade'><Border Background='{DynamicResource Card}' BorderBrush='{DynamicResource Border}' BorderThickness='1' CornerRadius='6' MinWidth='{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}' MaxHeight='260'><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation='Contained'/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property='IsEnabled' Value='False'><Setter Property='Opacity' Value='0.5'/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin='30,24,30,18'>
  <Grid.RowDefinitions><RowDefinition Height='Auto'/><RowDefinition Height='Auto'/><RowDefinition Height='*'/><RowDefinition Height='Auto'/></Grid.RowDefinitions>
  <Grid Margin='0,0,0,22'>
   <Grid.ColumnDefinitions><ColumnDefinition Width='Auto'/><ColumnDefinition Width='*'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions>
   <Image x:Name='LogoImage' Width='52' Height='52' Margin='0,0,14,0' RenderOptions.BitmapScalingMode='HighQuality'/>
   <StackPanel Grid.Column='1'><StackPanel Orientation='Horizontal'><TextBlock Text='DongleDeck' FontSize='25' FontWeight='SemiBold'/><Border Background='{DynamicResource Subtle}' CornerRadius='5' Padding='7,3' Margin='10,7,0,0' VerticalAlignment='Top'><TextBlock Text='v0.4' Foreground='{DynamicResource Muted}' FontSize='10'/></Border></StackPanel><TextBlock Text='Pair and manage Dell keyboards and mice.' Foreground='{DynamicResource Muted}' FontSize='13' Margin='0,3,0,0'/></StackPanel>
   <Button x:Name='ThemeButton' Grid.Column='2' Content='Light mode' Padding='12,8' VerticalAlignment='Top' Margin='12,4,0,0' ToolTip='Switch between dark and light mode'/>
  </Grid>
  <Border Grid.Row='1' Background='{DynamicResource Card}' BorderBrush='{DynamicResource Border}' BorderThickness='1' CornerRadius='12' Padding='22,18' Margin='0,0,0,18'>
   <Grid><Grid.RowDefinitions><RowDefinition Height='Auto'/><RowDefinition Height='Auto'/><RowDefinition Height='Auto'/></Grid.RowDefinitions>
    <TextBlock Text='CONNECTED RECEIVER' FontSize='10' FontWeight='Bold' Foreground='{DynamicResource Muted}' Margin='0,0,0,8'/>
    <Grid Grid.Row='1'><Grid.ColumnDefinitions><ColumnDefinition Width='*'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions><ComboBox x:Name='ReceiverBox' AutomationProperties.Name='Connected receiver'/><Button x:Name='RefreshButton' Grid.Column='1' Content='Refresh' Margin='12,0,0,0'/></Grid>
    <Grid Grid.Row='2' Margin='0,10,0,0'><Grid.ColumnDefinitions><ColumnDefinition Width='*'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions><TextBlock x:Name='ReceiverMeta' Text='Looking for a receiver…' Foreground='{DynamicResource Muted}' FontSize='11'/><TextBlock x:Name='CapacityText' Grid.Column='1' Foreground='{DynamicResource Accent}' FontSize='12' FontWeight='SemiBold'/></Grid>
   </Grid>
  </Border>
  <ScrollViewer Grid.Row='2' VerticalScrollBarVisibility='Auto' HorizontalScrollBarVisibility='Disabled'>
   <StackPanel>
    <Grid Margin='0,0,0,12'><Grid.ColumnDefinitions><ColumnDefinition Width='*'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions><StackPanel VerticalAlignment='Center'><TextBlock Text='Paired devices' FontSize='17' FontWeight='SemiBold'/><TextBlock Text='Switch a device off and on to identify its exact row.' Foreground='{DynamicResource Muted}' FontSize='12' Margin='0,4,0,0'/></StackPanel><Button x:Name='ClearButton' Grid.Column='1' Content='Clear pairings' Foreground='{DynamicResource Danger}' Padding='13,8' VerticalAlignment='Center'/></Grid>
    <Border Background='{DynamicResource Card}' CornerRadius='10' BorderBrush='{DynamicResource Border}' BorderThickness='1'>
     <Grid><StackPanel x:Name='EmptyPanel' Margin='22,23'><TextBlock Text='No paired devices' FontWeight='SemiBold' FontSize='14'/><TextBlock Text='Add a keyboard and mouse to get this receiver ready.' Foreground='{DynamicResource Muted}' Margin='0,5,0,0'/></StackPanel>
      <ItemsControl x:Name='DeviceList'><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush='{DynamicResource Border}' BorderThickness='0,0,0,1' Padding='20,12'><Grid><Grid.ColumnDefinitions><ColumnDefinition Width='42'/><ColumnDefinition Width='*'/><ColumnDefinition Width='160'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions><Border Width='30' Height='30' Background='{DynamicResource Subtle}' CornerRadius='7' VerticalAlignment='Center'><TextBlock Text='●' Foreground='{Binding ActivityColor}' HorizontalAlignment='Center' VerticalAlignment='Center'/></Border><StackPanel Grid.Column='1'><TextBlock Text='{Binding Title}' FontSize='14' FontWeight='SemiBold'/><TextBlock Text='{Binding Detail}' Foreground='{DynamicResource Muted}' FontSize='11' Margin='0,3,0,0'/></StackPanel><StackPanel Grid.Column='2' VerticalAlignment='Center'><TextBlock Text='{Binding ActivityText}' Foreground='{Binding ActivityColor}' FontSize='12' FontWeight='SemiBold'/><TextBlock Text='{Binding BatteryText}' Foreground='{DynamicResource Muted}' FontSize='11' Margin='0,3,0,0'/></StackPanel><Button Grid.Column='3' Content='Remove' Tag='{Binding}' Padding='13,7' VerticalAlignment='Center' Foreground='{DynamicResource Danger}'/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </Grid>
    </Border>
    <TextBlock x:Name='ActivityText' Foreground='{DynamicResource Muted}' FontSize='11' Margin='2,10,0,0' TextWrapping='Wrap'/>
    <Grid Margin='0,16,0,0'><Grid.ColumnDefinitions><ColumnDefinition Width='Auto'/><ColumnDefinition Width='*'/></Grid.ColumnDefinitions>
     <Button x:Name='PairButton' Background='#237446' BorderBrush='#237446' Foreground='White' MinWidth='170' AutomationProperties.Name='Start pairing'><StackPanel Orientation='Horizontal'><TextBlock x:Name='PairButtonGlyph' Text='▶' Margin='0,0,9,0' FontSize='11' VerticalAlignment='Center'/><TextBlock x:Name='PairButtonText' Text='Start pairing'/></StackPanel></Button>
     <StackPanel Grid.Column='1' Orientation='Horizontal' VerticalAlignment='Center' Margin='18,0,0,0'>
      <Canvas Width='34' Height='30' Margin='0,0,10,0' AutomationProperties.Name='Radio scan indicator'><Ellipse Width='5' Height='5' Canvas.Left='14.5' Canvas.Top='24' Fill='{DynamicResource Success}'/><Path x:Name='WaveNear' Data='M 11,21 Q 17,15 23,21' Stroke='{DynamicResource Success}' StrokeThickness='2.5' StrokeStartLineCap='Round' StrokeEndLineCap='Round' Opacity='0.25'/><Path x:Name='WaveMid' Data='M 6,16 Q 17,5 28,16' Stroke='{DynamicResource Success}' StrokeThickness='2.5' StrokeStartLineCap='Round' StrokeEndLineCap='Round' Opacity='0.25'/><Path x:Name='WaveFar' Data='M 1,10 Q 17,-5 33,10' Stroke='{DynamicResource Success}' StrokeThickness='2.5' StrokeStartLineCap='Round' StrokeEndLineCap='Round' Opacity='0.25'/></Canvas>
      <TextBlock x:Name='ScanStateText' Text='Scanning is off' Foreground='{DynamicResource Muted}' FontSize='12' VerticalAlignment='Center' TextWrapping='Wrap'/>
     </StackPanel>
    </Grid>
    <CheckBox x:Name='AutoPairCheck' Content='Automatic pairing' IsChecked='True' VerticalAlignment='Center' Margin='2,13,0,0' FontSize='13' Foreground='{DynamicResource Text}'/>
    <Border x:Name='PairPanel' Visibility='Collapsed' Background='{DynamicResource ScanSurface}' BorderBrush='{DynamicResource ScanBorder}' BorderThickness='1' CornerRadius='10' Padding='20,16' Margin='0,17,0,0'>
     <StackPanel><TextBlock Text='Scanning is on' FontWeight='SemiBold' FontSize='16' Foreground='{DynamicResource Success}'/><TextBlock Text='Keeps scanning until you click Stop pairing, or all 6 slots are full.' Foreground='{DynamicResource Text}' FontSize='12' Margin='0,5,0,0'/><TextBlock x:Name='PairInstructions' TextWrapping='Wrap' Margin='0,12,0,12' FontSize='12' LineHeight='19'/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width='*'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions><TextBlock x:Name='SearchStatus' Foreground='{DynamicResource Success}' FontWeight='SemiBold' FontSize='12'/><TextBlock x:Name='CountdownText' Grid.Column='1' Foreground='{DynamicResource Muted}' FontSize='12'/></Grid>
      <ItemsControl x:Name='CandidateList' Margin='0,10,0,0'><ItemsControl.ItemTemplate><DataTemplate><Border Background='{DynamicResource Card}' CornerRadius='7' Padding='13,10' Margin='0,5,0,0'><Grid><Grid.ColumnDefinitions><ColumnDefinition Width='*'/><ColumnDefinition Width='Auto'/></Grid.ColumnDefinitions><StackPanel><TextBlock Text='{Binding Title}' FontWeight='SemiBold' FontSize='13'/><TextBlock Text='{Binding Detail}' Foreground='{DynamicResource Muted}' FontSize='11' Margin='0,3,0,0'/></StackPanel><Button Grid.Column='1' Content='Pair this device' Style='{StaticResource Primary}' Padding='12,7' Tag='{Binding}' IsEnabled='{Binding CanPair}'/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
    </Border>
    <Border x:Name='NoticeBorder' Background='{DynamicResource SuccessSoft}' CornerRadius='8' Padding='15,12' Margin='0,17,0,0'><TextBlock x:Name='NoticeText' Text='Plug in a Dell Universal receiver to begin.' Foreground='{DynamicResource Success}' TextWrapping='Wrap' FontSize='12' LineHeight='18'/></Border>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row='3' Margin='0,16,0,0'><Grid.ColumnDefinitions><ColumnDefinition Width='Auto'/><ColumnDefinition Width='*'/></Grid.ColumnDefinitions><ProgressBar x:Name='OperationProgress' Width='76' Height='5' Visibility='Collapsed' Foreground='{DynamicResource Accent}' Background='{DynamicResource Border}' BorderThickness='0' VerticalAlignment='Center' Margin='0,0,12,0'/><TextBlock x:Name='BottomStatus' Grid.Column='1' Text='Ready' Foreground='{DynamicResource Muted}' FontSize='12'/></Grid>
 </Grid>
</Window>
